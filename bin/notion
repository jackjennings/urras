#!/usr/bin/env -S deno run --allow-env=NOTION_TOKEN --allow-net=api.notion.com --allow-read=-

import { Client } from "@notionhq/client";
import type {
  BlockObjectResponse,
  RichTextItemResponse,
} from "@notionhq/client/build/src/api-endpoints";

export function parseNotionId(input: string): string | null {
  let segment: string;
  try {
    const { pathname } = new URL(input);
    const parts = pathname.split("/").filter(Boolean);
    segment = parts[parts.length - 1] ?? "";
  } catch {
    return null;
  }
  const uuidMatch = segment.match(
    /([0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})$/i,
  );
  if (uuidMatch) return uuidMatch[1];
  const hexMatch = segment.match(/([0-9a-f]{31,32})$/i);
  return hexMatch ? hexMatch[1] : null;
}

export function richTextToMarkdown(richText: RichTextItemResponse[]): string {
  return richText
    .map((segment) => {
      let text = segment.plain_text;
      if (segment.annotations.bold) text = `**${text}**`;
      if (segment.annotations.italic) text = `_${text}_`;
      return text;
    })
    .join("");
}

export function blockToMarkdown(block: BlockObjectResponse): string {
  switch (block.type) {
    case "paragraph":
      return richTextToMarkdown(block.paragraph.rich_text);
    case "heading_1":
      return `# ${richTextToMarkdown(block.heading_1.rich_text)}`;
    case "heading_2":
      return `## ${richTextToMarkdown(block.heading_2.rich_text)}`;
    case "heading_3":
      return `### ${richTextToMarkdown(block.heading_3.rich_text)}`;
    case "bulleted_list_item":
      return `- ${richTextToMarkdown(block.bulleted_list_item.rich_text)}`;
    case "numbered_list_item":
      return `1. ${richTextToMarkdown(block.numbered_list_item.rich_text)}`;
    case "code":
      return `\`\`\`${block.code.language}\n${
        richTextToMarkdown(block.code.rich_text)
      }\n\`\`\``;
    case "quote":
      return `> ${richTextToMarkdown(block.quote.rich_text)}`;
    case "divider":
      return "---";
    case "child_page":
      return `[${block.child_page.title}](https://www.notion.so/${block.id})`;
    default:
      return "";
  }
}

async function fetchBlocks(
  client: Client,
  id: string,
  count: { value: number },
): Promise<{ lines: string[]; truncated: boolean }> {
  const lines: string[] = [];
  let cursor: string | undefined;

  outer: while (true) {
    const response = await client.blocks.children.list({
      block_id: id,
      ...(cursor ? { start_cursor: cursor } : {}),
    });

    for (const block of response.results as BlockObjectResponse[]) {
      if (count.value >= 500) {
        return { lines, truncated: true };
      }
      count.value++;
      const line = blockToMarkdown(block);
      if (line) lines.push(line);

      if (block.has_children) {
        const child = await fetchBlocks(client, block.id, count);
        lines.push(...child.lines);
        if (child.truncated) return { lines, truncated: true };
      }
    }

    if (!response.has_more) break outer;
    cursor = response.next_cursor ?? undefined;
  }

  return { lines, truncated: false };
}

export async function runPage(client: Client, id: string): Promise<string> {
  const page = await client.pages.retrieve({ page_id: id });
  const props = (page as { properties: Record<string, unknown> }).properties;
  const titleProp = Object.values(props).find(
    (p) => (p as { type: string }).type === "title",
  ) as { title: RichTextItemResponse[] } | undefined;
  const title = titleProp ? richTextToMarkdown(titleProp.title) : "";

  const { lines, truncated } = await fetchBlocks(client, id, { value: 0 });
  const parts = [`# ${title}`, ...lines];
  if (truncated) parts.push("<!-- truncated: block limit reached -->");
  return parts.join("\n\n");
}

export function propertyToString(prop: Record<string, unknown>): string {
  const type = prop.type as string;
  switch (type) {
    case "title":
      return richTextToMarkdown(
        (prop.title as RichTextItemResponse[]) ?? [],
      );
    case "rich_text":
      return richTextToMarkdown(
        (prop.rich_text as RichTextItemResponse[]) ?? [],
      );
    case "number":
      return prop.number == null ? "" : String(prop.number);
    case "select": {
      const s = prop.select as { name: string } | null;
      return s?.name ?? "";
    }
    case "multi_select":
      return (
        (prop.multi_select as { name: string }[])?.map((o) => o.name).join(
          ", ",
        ) ?? ""
      );
    case "date": {
      const d = prop.date as { start: string } | null;
      return d?.start ?? "";
    }
    case "checkbox":
      return String(prop.checkbox);
    default:
      return "";
  }
}

export function databaseToMarkdown(
  headers: string[],
  rows: string[][],
): string {
  const sep = headers.map(() => "---");
  const toRow = (cells: string[]) =>
    `| ${cells.map((c) => c.replace(/\|/g, "\\|")).join(" | ")} |`;
  return [toRow(headers), toRow(sep), ...rows.map(toRow)].join("\n");
}

export async function runDatabase(client: Client, id: string): Promise<string> {
  const db = await client.databases.retrieve({ database_id: id });
  const dbTyped = db as {
    title: RichTextItemResponse[];
    properties: Record<string, Record<string, unknown>>;
  };
  const title = richTextToMarkdown(dbTyped.title);
  const headers = Object.keys(dbTyped.properties);

  const rows: string[][] = [];
  let cursor: string | undefined;
  let truncated = false;

  while (true) {
    const response = await client.databases.query({
      database_id: id,
      ...(cursor ? { start_cursor: cursor } : {}),
    });
    const results = response.results as {
      properties: Record<string, Record<string, unknown>>;
    }[];

    for (const row of results) {
      if (rows.length >= 500) {
        truncated = true;
        break;
      }
      rows.push(headers.map((h) => propertyToString(row.properties[h] ?? {})));
    }

    if (truncated || !response.has_more) break;
    cursor = response.next_cursor ?? undefined;
  }

  const parts = [`# ${title}`, databaseToMarkdown(headers, rows)];
  if (truncated) parts.push("<!-- truncated: row limit reached -->");
  return parts.join("\n\n");
}

export function searchResultsToMarkdown(results: unknown[]): string {
  return results
    .map((r) => {
      const result = r as {
        object: string;
        id: string;
        properties?: Record<string, Record<string, unknown>>;
        title?: RichTextItemResponse[];
      };
      const url = `https://www.notion.so/${result.id}`;
      let title: string;
      if (result.object === "database" && result.title) {
        title = richTextToMarkdown(result.title);
      } else if (result.properties) {
        const titleProp = Object.values(result.properties).find(
          (p) => p.type === "title",
        ) as { title: RichTextItemResponse[] } | undefined;
        title = titleProp ? richTextToMarkdown(titleProp.title) : "(untitled)";
      } else {
        title = "(untitled)";
      }
      return `- [${title}](${url}) (${result.object})`;
    })
    .join("\n");
}

export async function runSearch(
  client: Client,
  query: string,
): Promise<string> {
  const items: unknown[] = [];
  let cursor: string | undefined;
  let truncated = false;

  while (true) {
    const response = await client.search({
      query,
      ...(cursor ? { start_cursor: cursor } : {}),
    });

    for (const result of response.results) {
      if (items.length >= 20) {
        truncated = true;
        break;
      }
      items.push(result);
    }

    if (truncated || !response.has_more) break;
    cursor = response.next_cursor ?? undefined;
  }

  if (items.length === 0) return `No results found for query: ${query}`;

  const lines = [searchResultsToMarkdown(items)];
  if (truncated) lines.push("<!-- truncated: result limit reached -->");
  return lines.join("\n\n");
}

type RichTextInput = {
  type: "text";
  text: { content: string; link?: { url: string } };
  annotations?: { bold?: boolean; italic?: boolean; code?: boolean };
};
type BlockInput = Record<string, unknown>;

const INLINE_PATTERN =
  /`([^`]+)`|\*\*(.+?)\*\*|\[([^\]]+)\]\((https?:\/\/[^)\s]+)\)|(?<![\w*])_([^_]+)_(?![\w])|(?<!\*)\*([^*\s][^*]*)\*(?!\*)/g;

export function toRich(text: string): RichTextInput[] {
  const segments: RichTextInput[] = [];
  let cursor = 0;
  for (const match of text.matchAll(INLINE_PATTERN)) {
    if (match.index > cursor) {
      segments.push({
        type: "text",
        text: { content: text.slice(cursor, match.index) },
      });
    }
    const [, code, bold, linkText, linkUrl, underscoreItalic, starItalic] =
      match;
    if (code !== undefined) {
      segments.push({
        type: "text",
        text: { content: code },
        annotations: { code: true },
      });
    } else if (bold !== undefined) {
      for (const inner of toRich(bold)) {
        segments.push({
          ...inner,
          annotations: { ...inner.annotations, bold: true },
        });
      }
    } else if (linkText !== undefined) {
      segments.push({
        type: "text",
        text: { content: linkText, link: { url: linkUrl } },
      });
    } else {
      segments.push({
        type: "text",
        text: { content: underscoreItalic ?? starItalic },
        annotations: { italic: true },
      });
    }
    cursor = match.index + match[0].length;
  }
  if (cursor < text.length) {
    segments.push({ type: "text", text: { content: text.slice(cursor) } });
  }
  return segments.length > 0
    ? segments
    : [{ type: "text", text: { content: text } }];
}

function splitTableRow(line: string): string[] {
  const trimmed = line.trim().replace(/^\|/, "").replace(/\|$/, "");
  return trimmed.split(/(?<!\\)\|/).map((cell) =>
    cell.trim().replace(/\\\|/g, "|")
  );
}

function isTableSeparator(line: string): boolean {
  return /^\s*\|?\s*:?-{3,}:?\s*(\|\s*:?-{3,}:?\s*)*\|?\s*$/.test(line) &&
    line.includes("|");
}

function tableBlock(rows: string[][]): BlockInput {
  const width = Math.max(...rows.map((row) => row.length));
  return {
    type: "table",
    table: {
      table_width: width,
      has_column_header: true,
      has_row_header: false,
      children: rows.map((row) => ({
        type: "table_row",
        table_row: {
          cells: Array.from({ length: width }, (_, index) =>
            toRich(row[index] ?? "")),
        },
      })),
    },
  };
}

export function markdownToBlocks(markdown: string): BlockInput[] {
  const lines = markdown.split("\n");
  const blocks: BlockInput[] = [];
  let i = 0;

  while (i < lines.length) {
    const line = lines[i];

    const fenceMatch = line.match(/^```([^\s`]*)/);
    if (fenceMatch) {
      const language = fenceMatch[1] || "plain text";
      const codeLines: string[] = [];
      i++;
      while (i < lines.length && !lines[i].startsWith("```")) {
        codeLines.push(lines[i]);
        i++;
      }
      i++;
      blocks.push({
        type: "code",
        code: { rich_text: toRich(codeLines.join("\n")), language },
      });
      continue;
    }

    if (
      line.includes("|") && i + 1 < lines.length &&
      isTableSeparator(lines[i + 1])
    ) {
      const rows = [splitTableRow(line)];
      i += 2;
      while (i < lines.length && lines[i].includes("|") && lines[i].trim()) {
        rows.push(splitTableRow(lines[i]));
        i++;
      }
      blocks.push(tableBlock(rows));
      continue;
    }

    if (line.startsWith("### ")) {
      blocks.push({
        type: "heading_3",
        heading_3: { rich_text: toRich(line.slice(4)) },
      });
      i++;
      continue;
    }

    if (line.startsWith("## ")) {
      blocks.push({
        type: "heading_2",
        heading_2: { rich_text: toRich(line.slice(3)) },
      });
      i++;
      continue;
    }

    if (line.startsWith("# ")) {
      blocks.push({
        type: "heading_1",
        heading_1: { rich_text: toRich(line.slice(2)) },
      });
      i++;
      continue;
    }

    const bulletMatch = line.match(/^[-*] (.+)/);
    if (bulletMatch) {
      blocks.push({
        type: "bulleted_list_item",
        bulleted_list_item: { rich_text: toRich(bulletMatch[1]) },
      });
      i++;
      continue;
    }

    const numberedMatch = line.match(/^\d+\. (.+)/);
    if (numberedMatch) {
      blocks.push({
        type: "numbered_list_item",
        numbered_list_item: { rich_text: toRich(numberedMatch[1]) },
      });
      i++;
      continue;
    }

    const quoteMatch = line.match(/^> (.+)/);
    if (quoteMatch) {
      blocks.push({
        type: "quote",
        quote: { rich_text: toRich(quoteMatch[1]) },
      });
      i++;
      continue;
    }

    if (/^---+\s*$/.test(line)) {
      blocks.push({ type: "divider", divider: {} });
      i++;
      continue;
    }

    if (line.trim() === "") {
      i++;
      continue;
    }

    const paragraphLines: string[] = [];
    while (i < lines.length && lines[i].trim() !== "") {
      const l = lines[i];
      if (
        l.startsWith("# ") || l.startsWith("## ") || l.startsWith("### ") ||
        l.match(/^[-*] /) || l.match(/^\d+\. /) || l.startsWith("> ") ||
        l.startsWith("```") || /^---+\s*$/.test(l) ||
        (l.includes("|") && i + 1 < lines.length &&
          isTableSeparator(lines[i + 1]))
      ) break;
      paragraphLines.push(l);
      i++;
    }
    if (paragraphLines.length > 0) {
      blocks.push({
        type: "paragraph",
        paragraph: { rich_text: toRich(paragraphLines.join("\n")) },
      });
    }
  }

  return blocks;
}

export async function runCreate(
  client: Client,
  parentPageUrl: string,
  title: string,
): Promise<string> {
  const parentId = parseNotionId(parentPageUrl);
  if (!parentId) {
    throw new Error(`could not parse Notion ID from URL: ${parentPageUrl}`);
  }
  const response = await client.pages.create({
    parent: { page_id: parentId },
    properties: {
      title: { title: [{ type: "text", text: { content: title } }] },
    },
  }) as { id: string };
  return `https://www.notion.so/${response.id}`;
}

const MAX_BLOCKS_PER_REQUEST = 100;

async function appendBlocks(
  client: Client,
  pageId: string,
  blocks: BlockInput[],
): Promise<void> {
  for (let start = 0; start < blocks.length; start += MAX_BLOCKS_PER_REQUEST) {
    await client.blocks.children.append({
      block_id: pageId,
      children: blocks.slice(start, start + MAX_BLOCKS_PER_REQUEST) as Parameters<
        typeof client.blocks.children.append
      >[0]["children"],
    });
  }
}

export async function runAppend(
  client: Client,
  pageUrl: string,
  markdown: string,
): Promise<void> {
  const pageId = parseNotionId(pageUrl);
  if (!pageId) {
    throw new Error(`could not parse Notion ID from URL: ${pageUrl}`);
  }
  await appendBlocks(client, pageId, markdownToBlocks(markdown));
}

export async function runReplace(
  client: Client,
  pageUrl: string,
  markdown: string,
  title?: string,
): Promise<void> {
  const pageId = parseNotionId(pageUrl);
  if (!pageId) {
    throw new Error(`could not parse Notion ID from URL: ${pageUrl}`);
  }
  const blocks = markdownToBlocks(markdown);
  if (blocks.length === 0) {
    throw new Error("refusing to replace page content with empty Markdown");
  }

  const existing: BlockObjectResponse[] = [];
  let cursor: string | undefined;
  while (true) {
    const response = await client.blocks.children.list({
      block_id: pageId,
      ...(cursor ? { start_cursor: cursor } : {}),
    });
    existing.push(...(response.results as BlockObjectResponse[]));
    if (!response.has_more) break;
    cursor = response.next_cursor ?? undefined;
  }

  await appendBlocks(client, pageId, blocks);

  for (const block of existing) {
    if (block.type === "child_page" || block.type === "child_database") continue;
    await client.blocks.delete({ block_id: block.id });
  }

  if (title) {
    await client.pages.update({
      page_id: pageId,
      properties: {
        title: { title: [{ type: "text", text: { content: title } }] },
      },
    });
  }
}

if (import.meta.main) {
  const token = Deno.env.get("NOTION_TOKEN");
  if (!token) {
    console.error("error: NOTION_TOKEN is not set");
    Deno.exit(1);
  }

  const [subcommand, ...rest] = Deno.args;
  const known = [
    "page",
    "database",
    "search",
    "create",
    "append",
    "replace",
  ];
  if (!subcommand || !known.includes(subcommand)) {
    console.error(
      "usage: notion page <url>\n" +
        "       notion database <url>\n" +
        "       notion search <query>\n" +
        "       notion create <parent-page-url> <title>\n" +
        "       notion append <page-url>\n" +
        "       notion replace <page-url> [title]",
    );
    Deno.exit(1);
  }

  const client = new Client({ auth: token });

  try {
    if (subcommand === "create") {
      const parentUrl = rest[0];
      const title = rest.slice(1).join(" ");
      if (!parentUrl || !title) {
        console.error(
          "usage: notion create <parent-page-url> <title>",
        );
        Deno.exit(1);
      }
      const url = await runCreate(client, parentUrl, title);
      console.log(url);
    } else if (subcommand === "append") {
      const pageUrl = rest[0];
      if (!pageUrl) {
        console.error("usage: notion append <page-url>");
        Deno.exit(1);
      }
      const markdown = await new Response(Deno.stdin.readable).text();
      await runAppend(client, pageUrl, markdown);
    } else if (subcommand === "replace") {
      const pageUrl = rest[0];
      if (!pageUrl) {
        console.error("usage: notion replace <page-url> [title]");
        Deno.exit(1);
      }
      const title = rest.slice(1).join(" ") || undefined;
      const markdown = await new Response(Deno.stdin.readable).text();
      await runReplace(client, pageUrl, markdown, title);
    } else {
      const arg = rest[0];
      if (!arg) {
        console.error(
          "usage: notion page <url>\n" +
            "       notion database <url>\n" +
            "       notion search <query>\n" +
            "       notion create <parent-page-url> <title>\n" +
            "       notion append <page-url>\n" +
            "       notion replace <page-url> [title]",
        );
        Deno.exit(1);
      }
      let output: string;
      if (subcommand === "page" || subcommand === "database") {
        const id = parseNotionId(arg);
        if (!id) {
          console.error(`error: could not parse Notion ID from URL: ${arg}`);
          Deno.exit(1);
        }
        output = subcommand === "page"
          ? await runPage(client, id)
          : await runDatabase(client, id);
      } else {
        output = await runSearch(client, arg);
      }
      console.log(output);
    }
  } catch (err) {
    if (
      err && typeof err === "object" && "status" in err &&
      (err as { status: number }).status === 404
    ) {
      const id = rest[0] ? (parseNotionId(rest[0]) ?? rest[0]) : "";
      console.error(
        `error: Notion returned 404 for ${id} — check that the integration has been granted access to this page`,
      );
    } else {
      console.error(err instanceof Error ? err.message : String(err));
    }
    Deno.exit(1);
  }
}
